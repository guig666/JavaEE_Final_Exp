<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.konsonx.dao.UserMapper">

  <!-- ===================================================== -->
  <!-- 结果映射：数据库字段与Java属性的对应关系（完整字段） -->
  <!-- ===================================================== -->
  <!--
      映射说明：
      - user_id → user_id（主键）
      - user_phone → user_phone（用户手机号）
      - user_alias → user_alias（用户昵称）
      - user_password → user_password（用户密码）
      - user_balance → user_balance（用户余额）
  -->
  <resultMap id="BaseResultMap" type="com.konsonx.po.User">
    <id column="user_id" jdbcType="INTEGER" property="user_id" />
    <result column="user_phone" jdbcType="VARCHAR" property="user_phone" />
    <result column="user_alias" jdbcType="VARCHAR" property="user_alias" />
    <result column="user_password" jdbcType="VARCHAR" property="user_password" />
    <result column="user_balance" jdbcType="REAL" property="user_balance" />
  </resultMap>

  <!-- ===================================================== -->
  <!-- 完整字段列表：包含密码，用于需要完整信息的场景 -->
  <!-- ===================================================== -->
  <sql id="Base_Column_List">
    user_id, user_phone, user_alias, user_password, user_balance
  </sql>

  <!-- ===================================================== -->
  <!-- 列表字段列表：不含密码，用于列表展示场景（安全性考虑） -->
  <!-- ===================================================== -->
  <!--
      设计说明：
      1. 列表查询时不返回密码字段，提高安全性
      2. 适用于用户列表、搜索等不需要密码的场景
  -->
  <sql id="List_Column_List">
    user_id, user_phone, user_alias, user_balance
  </sql>

  <!-- ===================================================== -->
  <!-- 按主键查询用户 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据user_id查询单个用户
      2. 使用BaseResultMap映射结果
      3. 返回完整字段（包含密码）
      4. 参数类型：Integer
  -->
  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from user
    where user_id = #{user_id,jdbcType=INTEGER}
  </select>

  <!-- ===================================================== -->
  <!-- 按主键删除用户 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据user_id删除记录
      2. 返回影响行数
  -->
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from user
    where user_id = #{user_id,jdbcType=INTEGER}
  </delete>

  <!-- ===================================================== -->
  <!-- 新增用户（全量插入） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 插入所有字段，包括null值
      2. 参数类型：User对象
  -->
  <insert id="insert" parameterType="com.konsonx.po.User">
    insert into user (user_id, user_phone, user_alias, user_password, user_balance)
    values (#{user_id,jdbcType=INTEGER}, #{user_phone,jdbcType=VARCHAR}, #{user_alias,jdbcType=VARCHAR},
            #{user_password,jdbcType=VARCHAR}, #{user_balance,jdbcType=REAL})
  </insert>

  <!-- ===================================================== -->
  <!-- 新增用户（选择性插入，推荐） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 只插入非空字段，未设置的字段使用数据库默认值
      2. 使用trim标签动态生成INSERT语句
      3. 更安全，避免插入null值覆盖默认值
  -->
  <insert id="insertSelective" parameterType="com.konsonx.po.User">
    insert into user
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="user_id != null">
        user_id,
      </if>
      <if test="user_phone != null">
        user_phone,
      </if>
      <if test="user_alias != null">
        user_alias,
      </if>
      <if test="user_password != null">
        user_password,
      </if>
      <if test="user_balance != null">
        user_balance,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="user_id != null">
        #{user_id,jdbcType=INTEGER},
      </if>
      <if test="user_phone != null">
        #{user_phone,jdbcType=VARCHAR},
      </if>
      <if test="user_alias != null">
        #{user_alias,jdbcType=VARCHAR},
      </if>
      <if test="user_password != null">
        #{user_password,jdbcType=VARCHAR},
      </if>
      <if test="user_balance != null">
        #{user_balance,jdbcType=REAL},
      </if>
    </trim>
  </insert>

  <!-- ===================================================== -->
  <!-- 选择性更新用户（推荐） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据user_id定位记录
      2. 使用set标签动态生成UPDATE语句
      3. 只更新非空字段，避免误覆盖
  -->
  <update id="updateByPrimaryKeySelective" parameterType="com.konsonx.po.User">
    update user
    <set>
      <if test="user_phone != null">
        user_phone = #{user_phone,jdbcType=VARCHAR},
      </if>
      <if test="user_alias != null">
        user_alias = #{user_alias,jdbcType=VARCHAR},
      </if>
      <if test="user_password != null">
        user_password = #{user_password,jdbcType=VARCHAR},
      </if>
      <if test="user_balance != null">
        user_balance = #{user_balance,jdbcType=REAL},
      </if>
    </set>
    where user_id = #{user_id,jdbcType=INTEGER}
  </update>

  <!-- ===================================================== -->
  <!-- 全量更新用户（谨慎使用） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据user_id定位记录
      2. 更新所有字段，null值也会被更新到数据库
      3. 可能导致字段被意外清空
  -->
  <update id="updateByPrimaryKey" parameterType="com.konsonx.po.User">
    update user
    set user_phone = #{user_phone,jdbcType=VARCHAR},
        user_alias = #{user_alias,jdbcType=VARCHAR},
        user_password = #{user_password,jdbcType=VARCHAR},
        user_balance = #{user_balance,jdbcType=REAL}
    where user_id = #{user_id,jdbcType=INTEGER}
  </update>

  <!-- ===================================================== -->
  <!-- 按手机号模糊查询用户列表（不含密码） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 动态拼接WHERE条件
      2. 使用concat('%', #{containingUser_phone}, '%')实现模糊匹配
      3. 如果传入参数为null，则查询所有记录
      4. 使用List_Column_List，不返回密码字段
      5. 配合PageHelper实现分页
  -->
  <select id="findbyUser_phonecontaining" resultMap="BaseResultMap">
    select
    <include refid="List_Column_List"/>
    from user
    where 1=1
    <if test="containingUser_phone!=null">
      and `user_phone` like concat('%',#{containingUser_phone,jdbcType=VARCHAR},'%')
    </if>
  </select>

  <!-- ===================================================== -->
  <!-- 按昵称模糊查询用户列表（不含密码） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 动态拼接WHERE条件
      2. 使用concat('%', #{containingUser_alias}, '%')实现模糊匹配
      3. 如果传入参数为null，则查询所有记录
      4. 使用List_Column_List，不返回密码字段
      5. 配合PageHelper实现分页
  -->
  <select id="findbyUser_aliascontaining" resultMap="BaseResultMap">
    select
    <include refid="List_Column_List"/>
    from user
    where 1=1
    <if test="containingUser_alias!=null">
      and `user_alias` like concat('%',#{containingUser_alias,jdbcType=VARCHAR},'%')
    </if>
  </select>

  <!-- ===================================================== -->
  <!-- 查询所有用户（按ID倒序，不含密码） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 查询所有用户
      2. 按user_id降序排列（最新注册的在最前）
      3. 使用List_Column_List，不返回密码字段
      4. 配合PageHelper实现分页
  -->
  <select id="findorderByuser_iddesc" resultMap="BaseResultMap">
    select
    <include refid="List_Column_List"/>
    from user order by `user_id` DESC
  </select>

  <!-- ===================================================== -->
  <!-- 查询所有用户（按ID正序，不含密码） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 查询所有用户
      2. 按user_id升序排列（最早注册的在最前）
      3. 使用List_Column_List，不返回密码字段
  -->
  <select id="findorderByuser_id" resultMap="BaseResultMap">
    select
    <include refid="List_Column_List"/>
    from user order by `user_id` asc
  </select>

  <!-- ===================================================== -->
  <!-- 按手机号精确查询用户（含密码，用于登录验证） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 使用等号精确匹配
      2. 使用Base_Column_List，包含密码字段
      3. 用于登录验证、账号唯一性检查（需要密码比对）
  -->
  <select id="findbyuser_phone" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List"/>
    from user
    where `user_phone` = #{user_phone,jdbcType=VARCHAR}
  </select>

</mapper>