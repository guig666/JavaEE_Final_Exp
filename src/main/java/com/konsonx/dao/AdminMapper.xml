<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.konsonx.dao.AdminMapper">

  <!-- ===================================================== -->
  <!-- 结果映射：数据库字段与Java属性的对应关系 -->
  <!-- ===================================================== -->
  <!--
      映射说明：
      - admin_id → admin_id（主键）
      - admin_account → admin_account（管理员账号）
      - admin_password → admin_password（管理员密码）
  -->
  <resultMap id="BaseResultMap" type="com.konsonx.po.Admin">
    <id column="admin_id" jdbcType="INTEGER" property="admin_id" />
    <result column="admin_account" jdbcType="VARCHAR" property="admin_account" />
    <result column="admin_password" jdbcType="VARCHAR" property="admin_password" />
  </resultMap>

  <!-- ===================================================== -->
  <!-- 基础字段列表：用于查询时引用，避免重复写字段名 -->
  <!-- ===================================================== -->
  <sql id="Base_Column_List">
    admin_id, admin_account, admin_password
  </sql>

  <!-- ===================================================== -->
  <!-- 按主键查询管理员 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据admin_id查询单个管理员
      2. 使用BaseResultMap映射结果
      3. 参数类型：Integer
  -->
  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List" />
    from admin
    where admin_id = #{admin_id,jdbcType=INTEGER}
  </select>

  <!-- ===================================================== -->
  <!-- 按主键删除管理员 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据admin_id删除记录
      2. 返回影响行数
  -->
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from admin
    where admin_id = #{admin_id,jdbcType=INTEGER}
  </delete>

  <!-- ===================================================== -->
  <!-- 新增管理员（全量插入） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 插入所有字段，包括null值
      2. 参数类型：Admin对象
  -->
  <insert id="insert" parameterType="com.konsonx.po.Admin">
    insert into admin (admin_id, admin_account, admin_password)
    values (#{admin_id,jdbcType=INTEGER}, #{admin_account,jdbcType=VARCHAR}, #{admin_password,jdbcType=VARCHAR})
  </insert>

  <!-- ===================================================== -->
  <!-- 新增管理员（选择性插入，推荐） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 只插入非空字段，未设置的字段使用数据库默认值
      2. 使用trim标签动态生成INSERT语句
      3. 更安全，避免插入null值覆盖默认值
  -->
  <insert id="insertSelective" parameterType="com.konsonx.po.Admin">
    insert into admin
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="admin_id != null">
        admin_id,
      </if>
      <if test="admin_account != null">
        admin_account,
      </if>
      <if test="admin_password != null">
        admin_password,
      </if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="admin_id != null">
        #{admin_id,jdbcType=INTEGER},
      </if>
      <if test="admin_account != null">
        #{admin_account,jdbcType=VARCHAR},
      </if>
      <if test="admin_password != null">
        #{admin_password,jdbcType=VARCHAR},
      </if>
    </trim>
  </insert>

  <!-- ===================================================== -->
  <!-- 选择性更新管理员（推荐） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据admin_id定位记录
      2. 使用set标签动态生成UPDATE语句
      3. 只更新非空字段，避免误覆盖
  -->
  <update id="updateByPrimaryKeySelective" parameterType="com.konsonx.po.Admin">
    update admin
    <set>
      <if test="admin_account != null">
        admin_account = #{admin_account,jdbcType=VARCHAR},
      </if>
      <if test="admin_password != null">
        admin_password = #{admin_password,jdbcType=VARCHAR},
      </if>
    </set>
    where admin_id = #{admin_id,jdbcType=INTEGER}
  </update>

  <!-- ===================================================== -->
  <!-- 全量更新管理员（谨慎使用） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 根据admin_id定位记录
      2. 更新所有字段，null值也会被更新到数据库
      3. 可能导致字段被意外清空
  -->
  <update id="updateByPrimaryKey" parameterType="com.konsonx.po.Admin">
    update admin
    set admin_account = #{admin_account,jdbcType=VARCHAR},
        admin_password = #{admin_password,jdbcType=VARCHAR}
    where admin_id = #{admin_id,jdbcType=INTEGER}
  </update>

  <!-- ===================================================== -->
  <!-- 按账号模糊查询管理员列表 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 动态拼接WHERE条件
      2. 使用concat('%', #{containingAdmin_account}, '%')实现模糊匹配
      3. 如果传入参数为null，则查询所有记录
      4. 配合PageHelper实现分页
  -->
  <select id="findByadmin_accountcontaining" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List"/>
    from admin
    where 1=1
    <if test="containingAdmin_account!=null">
      and `admin_account` like concat('%',#{containingAdmin_account,jdbcType=VARCHAR},'%')
    </if>
  </select>

  <!-- ===================================================== -->
  <!-- 查询所有管理员（按ID倒序） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 查询所有管理员
      2. 按admin_id降序排列（最新注册的在最前）
      3. 配合PageHelper实现分页
  -->
  <select id="findorderByAdmin_iddesc" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List"/>
    from admin order by `admin_id` desc
  </select>

  <!-- ===================================================== -->
  <!-- 查询所有管理员（按ID正序） -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 查询所有管理员
      2. 按admin_id升序排列（最早注册的在最前）
  -->
  <select id="findorderByadmin_id" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List"/>
    from admin order by `admin_id` asc
  </select>

  <!-- ===================================================== -->
  <!-- 按账号精确查询管理员 -->
  <!-- ===================================================== -->
  <!--
      核心逻辑：
      1. 动态拼接WHERE条件
      2. 使用等号精确匹配
      3. 用于登录验证、账号唯一性检查
  -->
  <select id="findByAdmin_account" resultMap="BaseResultMap">
    select
    <include refid="Base_Column_List"/>
    from admin
    where 1=1
    <if test="admin_account!=null">
      and `admin_account` = #{admin_account,jdbcType=VARCHAR}
    </if>
  </select>

</mapper>